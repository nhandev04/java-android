<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ecommerce" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColor">@color/mainText</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:itemBackground">@color/backgroundAd</item>
        <item name="colorSurface">@color/backgroundAd</item>
        <item name="colorOnSurface">@color/mainText</item>
        <item name="colorOnPrimary">@color/backgroundAd</item>
        <item name="colorOnSecondary">@color/backgroundAd</item>
        <item name="colorOnBackground">@color/mainText</item>
          <!-- Additional theme attributes for text colors -->
        <item name="textColorTitle">@color/mainText</item>
        <item name="textColorDescription">@color/textAd</item>
        <item name="textColorHighlight">@color/primary</item>
        <item name="textColorSecondary">@color/gray</item>
        <item name="colorDivider">@color/gray</item>
        
        <!-- Custom UI component attributes -->
        <item name="buttonBackgroundTint">@color/primary</item>
        <item name="buttonTextColor">@color/backgroundAd</item>
        <item name="cardBackgroundColor">@color/backgroundAd</item>
        <item name="imageOverlayColor">@color/overlay_dark</item>
        <item name="badgeBackgroundColor">@color/primary</item>
        <item name="promotionBackgroundColor">@color/sale</item>
        
        <!-- Status bar and navigation bar theming -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>